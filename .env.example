# disabled | file (local development only) | postgres (production)
AI_VISIT_STORAGE=disabled
# Must be an absolute path outside this project when storage=file
AI_VISIT_FILE_PATH=
DATABASE_URL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_IP_HASH_SECRET=

# 쓰레드 매일 자동 발행 (scripts/post-daily-thread.mjs)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# auto(기본) | bank(원고집만) | ai(Claude 생성만)
THREADS_SOURCE=auto
# 있으면 Claude로 매일 새 원고를 뽑습니다. 없으면 원고집이 순환합니다.
ANTHROPIC_API_KEY=
