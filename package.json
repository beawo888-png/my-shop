{
  "name": "my-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.mts",
    "test:ts": "tsx --test tests/*.test.mts",
    "db:migrate": "node scripts/migrate-ai-visits.mjs",
    "admin:secrets": "node scripts/generate-admin-secrets.mjs",
    "test:synthetic": "node scripts/synthetic-ai-visits.mjs",
    "threads:check": "node scripts/check-threads-posts.mjs",
    "threads:preview": "node scripts/post-daily-thread.mjs --dry-run",
    "threads:post": "node scripts/post-daily-thread.mjs",
    "smartplace:check": "node scripts/smartplace/check-posts.mjs",
    "smartplace:preview": "node scripts/smartplace/post-daily-news.mjs --dry-run",
    "smartplace:setup": "node scripts/smartplace/setup.mjs",
    "smartplace:test": "node scripts/smartplace/post-daily-news.mjs --check",
    "smartplace:post": "node scripts/smartplace/post-daily-news.mjs",
    "smartplace:daily": "node scripts/smartplace/daily.mjs",
    "smartplace:bookings": "node scripts/smartplace/daily.mjs --skip-reviews --skip-news",
    "smartplace:bookings-backfill": "node scripts/smartplace/backfill-bookings.mjs",
    "smartplace:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smartplace/register-task.ps1",
    "smartplace:unschedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smartplace/register-task.ps1 -Remove"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.24.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
